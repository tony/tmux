PROJECT_NAME = tmux-cxx
PROJECT_BRIEF = "Independent C++23 tmux server and native connection"
OUTPUT_DIRECTORY = _build/docs
INPUT = include src bindings/python/module.cpp bindings/node/addon.cpp tests/cpp tests/installed
FILE_PATTERNS = *.hpp *.cpp
RECURSIVE = YES
EXTRACT_ALL = NO
EXTRACT_PRIVATE = YES
EXTRACT_PRIV_VIRTUAL = YES
EXTRACT_STATIC = YES
EXTRACT_ANON_NSPACES = YES
HIDE_UNDOC_MEMBERS = NO
HIDE_UNDOC_CLASSES = NO
HIDE_UNDOC_NAMESPACES = NO
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC = NO
WARN_AS_ERROR = FAIL_ON_WARNINGS
WARN_LOGFILE = _build/reports/doxygen-warnings.log
GENERATE_HTML = YES
GENERATE_XML = YES
GENERATE_LATEX = NO
SOURCE_BROWSER = YES
STRIP_FROM_PATH = .
FULL_PATH_NAMES = NO
AUTOLINK_SUPPORT = YES
QUIET = YES
INCLUDE_PATH = include src
MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
PREDEFINED = "NB_MODULE(name,module)=void initialize_python(nanobind::module_ &module)" \
             "TEST(suite,name)=void suite##name()"
CLANG_ASSISTED_PARSING = NO
HAVE_DOT = NO
