# The upstream C implementation ignores executables and directories named
# `tmux`; retain the C++ stock-protocol namespace directories explicitly.
!src/protocol/tmux/
!src/protocol/tmux/**
!include/tmux_cxx/protocol/tmux/
!include/tmux_cxx/protocol/tmux/**
