@PACKAGE_INIT@

if(NOT TARGET tmux_cxx::vterm)
  add_library(tmux_cxx::vterm STATIC IMPORTED)
  set_target_properties(tmux_cxx::vterm PROPERTIES IMPORTED_LOCATION
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libtmux_cxx_vterm.a")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tmux_cxxTargets.cmake")
check_required_components(tmux_cxx)
