{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "skipLibCheck": false
  },
  "include": [
    "tests/types-positive.cts",
    "tests/*.test.ts",
    "tests/*.mts",
    "index.d.ts",
    "*.cjs",
    "tools/*.cjs"
  ]
}
